{
  "name": "dsh-auto-retry",
  "version": "0.6.2",
  "description": "DeepSeek Harness (DSH) 插件：断线重试 + 自动继续 + 同轮截断续写 + 压缩吞轮恢复 + 卡住检测",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "retry",
    "429",
    "rate-limit",
    "auto-continue",
    "watchdog",
    "max-tokens",
    "compaction"
  ],
  "license": "MIT",
  "author": "Amer-CN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amer-CN/dsh-retry-panel.git"
  },
  "homepage": "https://github.com/Amer-CN/dsh-retry-panel#readme",
  "bugs": {
    "url": "https://github.com/Amer-CN/dsh-retry-panel/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/server.test.mjs && node tests/client.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    }
  }
}
